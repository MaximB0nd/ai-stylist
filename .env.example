# Docker Compose Environment Variables

# PostgreSQL Settings
POSTGRES_USER=some_user
POSTGRES_PASSWORD=some_pass
POSTGRES_DB=stylist

# Backend Core Settings
# In production, generate a secure key: openssl rand -hex 32
SECRET_KEY=temporary-secret-key-for-dev-change-in-prod
PROJECT_NAME="AI Stylist Backend Core"
API_V1_PREFIX=/api/v1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend and Gateway Settings
FRONTEND_APP_ENV=development
NGINX_PORT=8080

# MinIO / S3 Settings (Permanent Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=stylist

# AI Core Integration Settings
AI_CORE_URL=http://ai-core:8001
AI_CORE_SERVICE_TOKEN=temporary-ai-core-service-token
AI_CORE_WEBHOOK_SECRET=temporary-ai-core-webhook-secret
