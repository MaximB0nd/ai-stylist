# Docker Compose Environment Variables

# PostgreSQL Settings
POSTGRES_USER=some_user
POSTGRES_PASSWORD=some_pass
POSTGRES_DB=stylist

# Backend Core Settings
# In production, generate a secure key: openssl rand -hex 32
SECRET_KEY=temporary-secret-key-for-dev-change-in-prod
PROJECT_NAME="AI Stylist Backend Core"
API_V1_PREFIX=/api/v1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend and Gateway Settings
FRONTEND_APP_ENV=development
NGINX_PORT=8080

# MinIO / S3 Settings (Permanent Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=stylist

# AI Core Integration Settings
AI_CORE_URL=http://ai-core:8001
AI_CORE_SERVICE_TOKEN=temporary-ai-core-service-token
AI_CORE_WEBHOOK_SECRET=temporary-ai-core-webhook-secret
AI_CORE_POSTGRES_PASSWORD=replace-with-a-strong-password
# Generate once and keep stable: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CORE_ORCHESTRATOR_ENCRYPTION_KEY=replace-with-a-persistent-fernet-key
# Address of this host reachable both from Docker containers and the native MPS worker.
AI_CORE_ARTIFACT_PUBLIC_BASE_URL=http://192.168.1.10:18081
AI_CORE_ARTIFACT_BIND_ADDRESS=0.0.0.0
# Source-photo origin signed by backend and accepted by artifact-service/public API.
# For native workers, use a host address reachable both from Docker and macOS.
AI_CORE_ARTIFACT_SOURCE_ORIGIN=http://192.168.1.10:9000
AI_CORE_INPUT_ORIGINS=["http://192.168.1.10:9000"]
# Artifact address embedded in worker requests. Native workers commonly use loopback;
# container workers may omit this and use the Docker-network default.
AI_CORE_ARTIFACT_WORKER_BASE_URL=http://127.0.0.1:18081
# JSON map of every required orchestrator stage. For the local MPS integration
# harness, all non-generation stages may point to one contract-fake server;
# never use that topology for production traffic.
AI_CORE_WORKER_URLS={"FACE_VALIDATION":"http://photo-validation:8000","BODY_VALIDATION":"http://photo-validation:8000","NORMALIZE_FACE":"http://person-normalization:8000","NORMALIZE_BODY":"http://person-normalization:8000","IDENTITY_VERIFICATION":"http://identity-verification:8000","COLOR_TYPE":"http://color-type:8000","STYLING":"http://styling:8000","GENERATION":"http://generation-worker:8000","VERIFICATION":"http://verification:8000"}
