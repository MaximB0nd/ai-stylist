# Application Settings
PROJECT_NAME="AI Stylist Backend Core"
API_V1_PREFIX="/api/v1"

# JWT & Security Settings
# Generate a secure key in production: openssl rand -hex 32
# Minimum 32 characters. Default below is for local development ONLY.
SECRET_KEY="temporary-secret-key-for-dev-change-in-prod-must-be-32plus"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (PostgreSQL 16)
# You can specify individual parameters (safe with special characters in passwords)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stylist

# Or specify full DATABASE_URL (optional override)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/stylist"

# MinIO / S3-compatible Storage
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=stylist
MINIO_SECURE=false
MINIO_PRESIGNED_TTL=3600

# AI Core Integration Settings
# In production, replace with real secrets (min 24 chars each):
# python -c "import secrets; print(secrets.token_hex(24))"
AI_CORE_URL=http://localhost:8001
AI_CORE_SERVICE_TOKEN=temporary-ai-core-service-token-change-in-prod
AI_CORE_WEBHOOK_SECRET=temporary-ai-core-webhook-secret-change-in-prod

