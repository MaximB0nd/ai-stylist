# Test Environment Configuration (Safe dummy values for pytest)
# This file is committed to git to enable isolated, reproducible test runs in CI/CD.

PROJECT_NAME="AI Stylist Backend Core (Test)"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"

# JWT & Security (valid format, >= 32 characters, safe test key)
SECRET_KEY="pytest-secret-key-for-test-execution-only-32ch"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (Test dummy parameters)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="pytest-postgres-pass"
POSTGRES_DB="stylist"
DATABASE_URL="postgresql+asyncpg://postgres:pytest-postgres-pass@localhost:5432/stylist"

# MinIO / S3-compatible Storage (Test dummy parameters)
MINIO_ENDPOINT="localhost:9000"
MINIO_PUBLIC_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="pytest-minio-access"
MINIO_SECRET_KEY="pytest-minio-secret"
MINIO_BUCKET="stylist"
MINIO_SECURE=false
MINIO_PRESIGNED_TTL=3600

# AI Core Integration Settings (valid format, >= 24 characters, safe test keys)
AI_CORE_URL="http://localhost:8001"
AI_CORE_SERVICE_TOKEN="pytest-ai-core-service-token-for-tests"
AI_CORE_WEBHOOK_SECRET="pytest-ai-core-webhook-secret-for-tests"
