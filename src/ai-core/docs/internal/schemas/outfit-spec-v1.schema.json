{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-core:outfit-spec:1.0",
  "title": "OutfitSpec 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outfit_id",
    "occasion",
    "style",
    "items",
    "constraints",
    "explanation"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "outfit_id": { "type": "string", "format": "uuid" },
    "occasion": { "type": "string", "minLength": 1 },
    "style": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "type", "color", "material"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "minLength": 1 },
          "material": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_body", "standing_pose"],
      "properties": {
        "full_body": { "type": "boolean" },
        "standing_pose": { "type": "boolean" }
      }
    },
    "explanation": { "type": "string", "maxLength": 500 }
  }
}
